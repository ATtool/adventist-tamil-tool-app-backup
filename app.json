{
  "expo": {
    "name": "Adventist Tamil Tool",
    "slug": "adventist-tamil-tool",
    "scheme": "adventisttamil",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#05070A"
      },
      "package": "com.adventisttamiltool.adventisttamiltool",
      "allowBackup": true,
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#05070A"
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Adventist Tamil Tool to access your camera to scan QR codes for joining services.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Adventist Tamil Tool to access your photos so you can select a QR code image to join a service.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "77e67f43-dfc6-43ad-ac5d-78b4a11e4b15"
      }
    }
  }
}
